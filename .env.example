# URL canónica del sitio (metadata, sitemap, Open Graph), p. ej. https://www.sumastudio.mx.
# Obligatoria en producción: si falta o es localhost, el build de producción falla.
# En previews de Vercel no hace falta: se usa la URL del preview y se marca noindex.
NEXT_PUBLIC_SITE_URL=

# Entrega del formulario de contacto (solo servidor). Configura UNA opción.
# Opción A: webhook (Make, Zapier, n8n…). Recibe POST JSON { source, lead }.
CONTACT_WEBHOOK_URL=

# Opción B: correo con Resend (cuenta propia de SUMA STUDIO). Las tres son obligatorias.
# API key de envío (formato re_…), idealmente restringida a "Sending access" y al dominio sumastudio.mx.
RESEND_API_KEY=
# Buzón real que recibe los prospectos (debe existir y leerse a diario).
CONTACT_TO_EMAIL=
# Remitente de un dominio VERIFICADO en Resend, p. ej.: SUMA STUDIO <contacto@sumastudio.mx>
# No se acepta @resend.dev (solo entrega a la cuenta dueña).
CONTACT_FROM_EMAIL=
